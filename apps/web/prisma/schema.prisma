generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  EMPLOYEE
  MANAGER
  HR_ADMIN
  SUPER_ADMIN
}

enum CycleStatus {
  DRAFT
  ACTIVE
  LOCKED
  RELEASED
}

enum CycleVisibilityPolicy {
  MANAGER_ONLY
  EMPLOYEE_AFTER_RELEASE
}

enum ReviewRelationship {
  SELF
  MANAGER
  PEER
  UPWARD
}

enum PeerAssignmentMode {
  HR_ASSIGNED
  NOMINATION
}

enum ReviewSubmissionStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  RETURNED
}

enum ReviewQuestionType {
  TEXT
  SCALE_1_TO_5
}

enum CompetencyDimensionKey {
  VALUES_CULTURE_ALIGNMENT
  JUDGMENT_DECISION_MAKING
  SAFETY_COMPLIANCE
  TECHNICAL_SKILLS
  QUALITY_OF_WORK
  COMMUNICATION
  ACCOUNTABILITY
  RELATIONSHIP_BUILDING
  RESULTS_DRIVEN
  ATTITUDE
  SERVICE_ORIENTED
  ADAPTABILITY
}

enum ScorecardMetricKey {
  QUALITY_OF_WORK
  COMMUNICATION
  ACCOUNTABILITY
  RELATIONSHIP_BUILDING
  RESULTS_DRIVEN
  ATTITUDE
  SERVICE_ORIENTED
  ADAPTABILITY
}

enum FinalRatingSource {
  SCORECARD
  CALIBRATION
}

enum EvidenceType {
  FEEDBACK
  UPDATE
  ONE_ON_ONE
  GOAL
  GOAL_UPDATE
  VALUE_RECOGNITION
}

enum EvidenceVisibility {
  PRIVATE
  MANAGER_ONLY
  SHARED_WITH_SUBJECT
  ORG_VISIBLE
}

enum GoalCycleCadence {
  QUARTERLY
  ANNUAL
}

enum GoalCycleStatus {
  DRAFT
  ACTIVE
  CLOSED
  ARCHIVED
}

enum GoalStatus {
  NOT_STARTED
  ON_TRACK
  AT_RISK
  OFF_TRACK
  COMPLETE
  CANCELED
}

enum GoalType {
  PERFORMANCE
  DEVELOPMENT
}

enum GoalWorkflowStatus {
  DRAFT
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED
  OVERRIDDEN
}

enum GoalVisibility {
  ORG
  TEAM
  PRIVATE
}

enum KeyResultType {
  PERCENT
  NUMBER
  BOOLEAN
}

enum CompetencyAlignmentLabel {
  NONE
  STRENGTH
  OPPORTUNITY
}

enum CalibrationBucket {
  LOW
  MEDIUM
  HIGH
}

enum ImprovementPlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
  EXTENDED
  CANCELED
}

enum ImprovementPlanOutcome {
  SUCCESSFUL
  UNSUCCESSFUL
}

enum ImprovementPlanTrigger {
  REVIEW
  CALIBRATION
  REVIEW_AND_CALIBRATION
}

enum ImprovementPlanCheckInType {
  NOTE
  CHECKPOINT_30
  CHECKPOINT_60
  CHECKPOINT_90
  STATUS_CHANGE
}

enum PositionStatus {
  ACTIVE
  ARCHIVED
}

enum SuccessionVisibilityScope {
  HR_ONLY
  MANAGERS_IN_SCOPE
}

enum SuccessionReadiness {
  READY_NOW
  ONE_TO_TWO_YEARS
  THREE_TO_FIVE_YEARS
  FUTURE
}

enum SuccessionAssessmentLevel {
  LOW
  MEDIUM
  HIGH
}

enum SuccessionNoteVisibility {
  HR_ONLY
  PLAN_VIEWERS
}

model Org {
  id                               String                            @id @default(cuid())
  name                             String
  createdAt                        DateTime                          @default(now())
  updatedAt                        DateTime                          @updatedAt
  users                            User[]
  memberships                      OrgMembership[]
  employees                        Employee[]
  reviewTemplates                  ReviewTemplate[]
  reviewTemplateQuestions          ReviewTemplateQuestion[]
  reviewCycles                     ReviewCycle[]
  reviewPackets                    ReviewPacket[]
  reviewSubmissions                ReviewSubmission[]
  reviewAnswers                    ReviewAnswer[]
  reviewCycleMetrics               ReviewCycleScorecardMetric[]
  scorecardMetricResults           ScorecardMetricResult[]
  evidenceItems                    EvidenceItem[]
  answerEvidenceLinks              AnswerEvidenceLink[]
  calibrationSessions              CalibrationSession[]
  calibrationPlacements            CalibrationPlacement[]
  calibrationParticipants          CalibrationSessionParticipant[]
  calibrationSnapshots             CalibrationSnapshot[]
  improvementPlans                 ImprovementPlan[]
  improvementPlanGoals             ImprovementPlanGoal[]
  improvementPlanCheckIns          ImprovementPlanCheckIn[]
  positions                        Position[]
  successionPlans                  SuccessionPlan[]
  successionPlanCollaborators      SuccessionPlanCollaborator[]
  successionPlanAllowedManagers    SuccessionPlanAllowedManager[]
  successionCandidates             SuccessionCandidate[]
  successionNotes                  SuccessionNote[]
  successionCandidateSnapshots     SuccessionCandidateSnapshot[]
  goalCycles                       GoalCycle[]
  goals                            Goal[]
  keyResults                       KeyResult[]
  goalUpdates                      GoalUpdate[]
  goalCompetencyLinks              GoalCompetencyLink[]
  goalWatchers                     GoalWatcher[]
  trackGroups                      TrackGroup[]
  tracks                           Track[]
  trackLevels                      TrackLevel[]
  competencyThemes                 CompetencyTheme[]
  competencies                     Competency[]
  trackLevelCompetencyExpectations TrackLevelCompetencyExpectation[]
  employeeTrackAssignments         EmployeeTrackAssignment[]
  competencyAlignmentComments      CompetencyAlignmentComment[]
  auditEvents                      AuditEvent[]
}

model User {
  id                        String                          @id @default(cuid())
  orgId                     String
  email                     String
  authIdentityId            String?                         @unique
  role                      UserRole                        @default(EMPLOYEE)
  employee                  Employee?
  memberships               OrgMembership[]
  createdAt                 DateTime                        @default(now())
  updatedAt                 DateTime                        @updatedAt
  org                       Org                             @relation(fields: [orgId], references: [id], onDelete: Restrict)
  auditEvents               AuditEvent[]
  calibrationParticipations CalibrationSessionParticipant[]
  improvementPlansCreated   ImprovementPlan[]
  improvementPlanCheckIns   ImprovementPlanCheckIn[]
  goalWatchers              GoalWatcher[]

  @@unique([orgId, email])
  @@index([orgId])
}

model OrgMembership {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  role      UserRole @default(EMPLOYEE)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([orgId, role])
  @@index([orgId, isActive])
  @@index([userId])
}

model Employee {
  id                           String                         @id @default(cuid())
  orgId                        String
  userId                       String                         @unique
  firstName                    String
  lastName                     String
  department                   String?
  title                        String?
  avatarUrl                    String?
  managerId                    String?
  createdAt                    DateTime                       @default(now())
  updatedAt                    DateTime                       @updatedAt
  org                          Org                            @relation(fields: [orgId], references: [id], onDelete: Restrict)
  user                         User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  manager                      Employee?                      @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  directReports                Employee[]                     @relation("EmployeeManager")
  incumbentPositions           Position[]                     @relation("PositionIncumbentEmployee")
  reviewPacketsAsSubject       ReviewPacket[]                 @relation("ReviewPacketSubjectEmployee")
  reviewSubmissionsAsSubject   ReviewSubmission[]             @relation("ReviewSubmissionSubjectEmployee")
  reviewSubmissionsAsReviewer  ReviewSubmission[]             @relation("ReviewSubmissionReviewerEmployee")
  evidenceAsSubject            EvidenceItem[]                 @relation("EvidenceSubjectEmployee")
  evidenceAuthored             EvidenceItem[]                 @relation("EvidenceAuthorEmployee")
  calibrationPlacements        CalibrationPlacement[]
  improvementPlansAsSubject    ImprovementPlan[]              @relation("ImprovementPlanSubjectEmployee")
  improvementPlansAsManager    ImprovementPlan[]              @relation("ImprovementPlanManagerEmployee")
  improvementPlansAsHrOwner    ImprovementPlan[]              @relation("ImprovementPlanHrOwnerEmployee")
  ownedGoals                   Goal[]                         @relation("GoalOwnerEmployee")
  goalUpdatesAuthored          GoalUpdate[]                   @relation("GoalUpdateAuthorEmployee")
  trackAssignment              EmployeeTrackAssignment?
  competencyAlignmentComments  CompetencyAlignmentComment[]   @relation("CompetencyAlignmentCommentAuthorEmployee")
  successionPlansOwned         SuccessionPlan[]               @relation("SuccessionPlanOwnerEmployee")
  successionPlanCollaborations SuccessionPlanCollaborator[]   @relation("SuccessionPlanCollaboratorEmployee")
  successionPlanManagerScopes  SuccessionPlanAllowedManager[] @relation("SuccessionPlanAllowedManagerEmployee")
  successionCandidateRoles     SuccessionCandidate[]          @relation("SuccessionCandidateEmployee")
  successionCandidateProposals SuccessionCandidate[]          @relation("SuccessionCandidateProposedByEmployee")
  successionNotesAuthored      SuccessionNote[]               @relation("SuccessionNoteAuthorEmployee")

  @@unique([orgId, userId])
  @@index([orgId])
  @@index([managerId])
}

model ReviewTemplate {
  id          String                   @id @default(cuid())
  orgId       String
  name        String
  description String?
  isDefault   Boolean                  @default(false)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  org         Org                      @relation(fields: [orgId], references: [id], onDelete: Restrict)
  questions   ReviewTemplateQuestion[]
  cycles      ReviewCycle[]

  @@unique([orgId, name])
  @@index([orgId])
}

model ReviewTemplateQuestion {
  id           String                  @id @default(cuid())
  orgId        String
  templateId   String
  prompt       String
  questionType ReviewQuestionType      @default(TEXT)
  dimensionKey CompetencyDimensionKey?
  isRequired   Boolean                 @default(true)
  sortOrder    Int                     @default(0)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  org          Org                     @relation(fields: [orgId], references: [id], onDelete: Restrict)
  template     ReviewTemplate          @relation(fields: [templateId], references: [id], onDelete: Cascade)
  answers      ReviewAnswer[]

  @@index([orgId])
  @@index([templateId, sortOrder])
  @@index([templateId, dimensionKey])
}

model ReviewCycle {
  id                           String                        @id @default(cuid())
  orgId                        String
  name                         String
  startDate                    DateTime
  endDate                      DateTime
  status                       CycleStatus                   @default(DRAFT)
  visibilityPolicy             CycleVisibilityPolicy         @default(EMPLOYEE_AFTER_RELEASE)
  selfReviewRequired           Boolean                       @default(true)
  managerReviewRequired        Boolean                       @default(true)
  peerReviewCount              Int                           @default(0)
  peerAssignmentMode           PeerAssignmentMode            @default(HR_ASSIGNED)
  upwardReviewCount            Int                           @default(0)
  upwardReviewsForManagersOnly Boolean                       @default(true)
  selfReviewDueAt              DateTime?
  managerReviewDueAt           DateTime?
  peerReviewDueAt              DateTime?
  upwardReviewDueAt            DateTime?
  templateId                   String?
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  org                          Org                           @relation(fields: [orgId], references: [id], onDelete: Restrict)
  template                     ReviewTemplate?               @relation(fields: [templateId], references: [id], onDelete: SetNull)
  packets                      ReviewPacket[]
  submissions                  ReviewSubmission[]
  calibrationSessions          CalibrationSession[]
  improvementPlans             ImprovementPlan[]
  successionCandidateSnapshots SuccessionCandidateSnapshot[]
  scorecardMetrics             ReviewCycleScorecardMetric[]

  @@index([orgId])
  @@index([orgId, status])
}

model TrackGroup {
  id          String   @id @default(cuid())
  orgId       String
  slug        String
  name        String
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  org         Org      @relation(fields: [orgId], references: [id], onDelete: Restrict)
  tracks      Track[]

  @@unique([orgId, slug])
  @@index([orgId])
  @@index([orgId, sortOrder])
}

model Track {
  id           String                    @id @default(cuid())
  orgId        String
  trackGroupId String
  slug         String
  name         String
  description  String?
  isPublished  Boolean                   @default(false)
  sortOrder    Int                       @default(0)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  org          Org                       @relation(fields: [orgId], references: [id], onDelete: Restrict)
  trackGroup   TrackGroup                @relation(fields: [trackGroupId], references: [id], onDelete: Cascade)
  levels       TrackLevel[]
  assignments  EmployeeTrackAssignment[]

  @@unique([orgId, slug])
  @@index([orgId])
  @@index([trackGroupId])
  @@index([orgId, isPublished])
  @@index([trackGroupId, sortOrder])
}

model TrackLevel {
  id           String                            @id @default(cuid())
  orgId        String
  trackId      String
  slug         String
  name         String
  description  String?
  levelOrder   Int                               @default(0)
  createdAt    DateTime                          @default(now())
  updatedAt    DateTime                          @updatedAt
  org          Org                               @relation(fields: [orgId], references: [id], onDelete: Restrict)
  track        Track                             @relation(fields: [trackId], references: [id], onDelete: Cascade)
  expectations TrackLevelCompetencyExpectation[]
  assignments  EmployeeTrackAssignment[]

  @@unique([trackId, slug])
  @@unique([trackId, levelOrder])
  @@index([orgId])
  @@index([trackId])
}

model CompetencyTheme {
  id           String       @id @default(cuid())
  orgId        String
  slug         String
  name         String
  description  String?
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  org          Org          @relation(fields: [orgId], references: [id], onDelete: Restrict)
  competencies Competency[]

  @@unique([orgId, slug])
  @@index([orgId])
  @@index([orgId, sortOrder])
}

model Competency {
  id                String                            @id @default(cuid())
  orgId             String
  themeId           String?
  slug              String
  name              String
  description       String
  dimensionKey      CompetencyDimensionKey?
  createdAt         DateTime                          @default(now())
  updatedAt         DateTime                          @updatedAt
  org               Org                               @relation(fields: [orgId], references: [id], onDelete: Restrict)
  theme             CompetencyTheme?                  @relation(fields: [themeId], references: [id], onDelete: SetNull)
  expectations      TrackLevelCompetencyExpectation[]
  goalLinks         GoalCompetencyLink[]
  alignmentComments CompetencyAlignmentComment[]

  @@unique([orgId, slug])
  @@unique([orgId, dimensionKey])
  @@index([orgId])
  @@index([themeId])
}

model TrackLevelCompetencyExpectation {
  id           String     @id @default(cuid())
  orgId        String
  trackLevelId String
  competencyId String
  expectation  String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  org          Org        @relation(fields: [orgId], references: [id], onDelete: Restrict)
  trackLevel   TrackLevel @relation(fields: [trackLevelId], references: [id], onDelete: Cascade)
  competency   Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@unique([trackLevelId, competencyId])
  @@index([orgId])
  @@index([trackLevelId])
  @@index([competencyId])
}

model EmployeeTrackAssignment {
  id                String                       @id @default(cuid())
  orgId             String
  employeeId        String                       @unique
  trackId           String
  trackLevelId      String
  assignedAt        DateTime                     @default(now())
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  org               Org                          @relation(fields: [orgId], references: [id], onDelete: Restrict)
  employee          Employee                     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  track             Track                        @relation(fields: [trackId], references: [id], onDelete: Restrict)
  trackLevel        TrackLevel                   @relation(fields: [trackLevelId], references: [id], onDelete: Restrict)
  alignmentComments CompetencyAlignmentComment[]

  @@index([orgId])
  @@index([trackId])
  @@index([trackLevelId])
}

model CompetencyAlignmentComment {
  id                        String                   @id @default(cuid())
  orgId                     String
  employeeTrackAssignmentId String
  competencyId              String
  authorEmployeeId          String
  label                     CompetencyAlignmentLabel @default(NONE)
  note                      String
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  org                       Org                      @relation(fields: [orgId], references: [id], onDelete: Restrict)
  employeeTrackAssignment   EmployeeTrackAssignment  @relation(fields: [employeeTrackAssignmentId], references: [id], onDelete: Cascade)
  competency                Competency               @relation(fields: [competencyId], references: [id], onDelete: Restrict)
  authorEmployee            Employee                 @relation("CompetencyAlignmentCommentAuthorEmployee", fields: [authorEmployeeId], references: [id], onDelete: Restrict)

  @@index([orgId])
  @@index([employeeTrackAssignmentId])
  @@index([competencyId])
  @@index([authorEmployeeId])
}

model GoalCycle {
  id        String           @id @default(cuid())
  orgId     String
  name      String
  cadence   GoalCycleCadence
  startDate DateTime
  endDate   DateTime
  status    GoalCycleStatus  @default(DRAFT)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  org       Org              @relation(fields: [orgId], references: [id], onDelete: Restrict)
  goals     Goal[]

  @@unique([orgId, name])
  @@index([orgId])
  @@index([orgId, status])
}

model Goal {
  id              String               @id @default(cuid())
  orgId           String
  ownerEmployeeId String
  cycleId         String
  goalType        GoalType             @default(PERFORMANCE)
  title           String
  description     String?
  status          GoalStatus           @default(NOT_STARTED)
  progressPercent Float                @default(0)
  workflowStatus  GoalWorkflowStatus   @default(DRAFT)
  workflowNote    String?
  submittedAt     DateTime?
  approvedAt      DateTime?
  visibility      GoalVisibility       @default(TEAM)
  parentGoalId    String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  org             Org                  @relation(fields: [orgId], references: [id], onDelete: Restrict)
  ownerEmployee   Employee             @relation("GoalOwnerEmployee", fields: [ownerEmployeeId], references: [id], onDelete: Restrict)
  cycle           GoalCycle            @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  parentGoal      Goal?                @relation("GoalCascade", fields: [parentGoalId], references: [id], onDelete: SetNull)
  childGoals      Goal[]               @relation("GoalCascade")
  keyResults      KeyResult[]
  updates         GoalUpdate[]
  competencyLinks GoalCompetencyLink[]
  watchers        GoalWatcher[]

  @@index([orgId])
  @@index([ownerEmployeeId])
  @@index([cycleId])
  @@index([parentGoalId])
  @@index([orgId, cycleId, ownerEmployeeId])
  @@index([orgId, status])
  @@index([orgId, workflowStatus])
}

model KeyResult {
  id           String        @id @default(cuid())
  orgId        String
  goalId       String
  title        String
  type         KeyResultType
  startValue   Float?
  targetValue  Float?
  currentValue Float?
  weight       Float?
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  org          Org           @relation(fields: [orgId], references: [id], onDelete: Restrict)
  goal         Goal          @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([goalId])
  @@index([goalId, sortOrder])
}

model GoalUpdate {
  id                      String   @id @default(cuid())
  orgId                   String
  goalId                  String
  authorEmployeeId        String
  note                    String
  progressDelta           Float?
  snapshotProgressPercent Float?
  snapshotCurrentValues   Json?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  org                     Org      @relation(fields: [orgId], references: [id], onDelete: Restrict)
  goal                    Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  authorEmployee          Employee @relation("GoalUpdateAuthorEmployee", fields: [authorEmployeeId], references: [id], onDelete: Restrict)

  @@index([orgId])
  @@index([goalId, createdAt])
  @@index([authorEmployeeId])
}

model GoalCompetencyLink {
  id           String     @id @default(cuid())
  orgId        String
  goalId       String
  competencyId String
  createdAt    DateTime   @default(now())
  org          Org        @relation(fields: [orgId], references: [id], onDelete: Restrict)
  goal         Goal       @relation(fields: [goalId], references: [id], onDelete: Cascade)
  competency   Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@unique([goalId, competencyId])
  @@index([orgId])
  @@index([goalId])
  @@index([competencyId])
}

model GoalWatcher {
  id        String   @id @default(cuid())
  orgId     String
  goalId    String
  userId    String
  createdAt DateTime @default(now())
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Restrict)
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([goalId, userId])
  @@index([orgId])
  @@index([goalId])
  @@index([userId])
}

model Position {
  id                  String          @id @default(cuid())
  orgId               String
  title               String
  department          String
  location            String?
  incumbentEmployeeId String?
  isCritical          Boolean         @default(false)
  status              PositionStatus  @default(ACTIVE)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  org                 Org             @relation(fields: [orgId], references: [id], onDelete: Restrict)
  incumbentEmployee   Employee?       @relation("PositionIncumbentEmployee", fields: [incumbentEmployeeId], references: [id], onDelete: SetNull)
  plan                SuccessionPlan?

  @@index([orgId])
  @@index([orgId, department])
  @@index([orgId, status])
  @@index([incumbentEmployeeId])
}

model SuccessionPlan {
  id              String                         @id @default(cuid())
  orgId           String
  positionId      String                         @unique
  ownerEmployeeId String
  visibilityScope SuccessionVisibilityScope      @default(MANAGERS_IN_SCOPE)
  reviewCadence   String?
  notes           String?
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt
  org             Org                            @relation(fields: [orgId], references: [id], onDelete: Restrict)
  position        Position                       @relation(fields: [positionId], references: [id], onDelete: Cascade)
  ownerEmployee   Employee                       @relation("SuccessionPlanOwnerEmployee", fields: [ownerEmployeeId], references: [id], onDelete: Restrict)
  collaborators   SuccessionPlanCollaborator[]
  allowedManagers SuccessionPlanAllowedManager[]
  candidates      SuccessionCandidate[]

  @@index([orgId])
  @@index([ownerEmployeeId])
  @@index([orgId, visibilityScope])
}

model SuccessionPlanCollaborator {
  id         String         @id @default(cuid())
  orgId      String
  planId     String
  employeeId String
  createdAt  DateTime       @default(now())
  org        Org            @relation(fields: [orgId], references: [id], onDelete: Restrict)
  plan       SuccessionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  employee   Employee       @relation("SuccessionPlanCollaboratorEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([planId, employeeId])
  @@index([orgId])
  @@index([employeeId])
}

model SuccessionPlanAllowedManager {
  id                String         @id @default(cuid())
  orgId             String
  planId            String
  managerEmployeeId String
  createdAt         DateTime       @default(now())
  org               Org            @relation(fields: [orgId], references: [id], onDelete: Restrict)
  plan              SuccessionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  managerEmployee   Employee       @relation("SuccessionPlanAllowedManagerEmployee", fields: [managerEmployeeId], references: [id], onDelete: Cascade)

  @@unique([planId, managerEmployeeId])
  @@index([orgId])
  @@index([managerEmployeeId])
}

model SuccessionCandidate {
  id                   String                        @id @default(cuid())
  orgId                String
  planId               String
  candidateEmployeeId  String
  readiness            SuccessionReadiness
  riskOfLoss           SuccessionAssessmentLevel?
  confidence           SuccessionAssessmentLevel?
  proposedByRole       UserRole
  proposedByEmployeeId String
  sortOrder            Int                           @default(0)
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt
  org                  Org                           @relation(fields: [orgId], references: [id], onDelete: Restrict)
  plan                 SuccessionPlan                @relation(fields: [planId], references: [id], onDelete: Cascade)
  candidateEmployee    Employee                      @relation("SuccessionCandidateEmployee", fields: [candidateEmployeeId], references: [id], onDelete: Cascade)
  proposedByEmployee   Employee                      @relation("SuccessionCandidateProposedByEmployee", fields: [proposedByEmployeeId], references: [id], onDelete: Restrict)
  notes                SuccessionNote[]
  snapshots            SuccessionCandidateSnapshot[]

  @@unique([planId, candidateEmployeeId])
  @@index([orgId])
  @@index([planId, sortOrder])
  @@index([candidateEmployeeId])
}

model SuccessionNote {
  id               String                   @id @default(cuid())
  orgId            String
  candidateId      String
  authorEmployeeId String
  authorRole       UserRole
  visibility       SuccessionNoteVisibility @default(PLAN_VIEWERS)
  body             String
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  org              Org                      @relation(fields: [orgId], references: [id], onDelete: Restrict)
  candidate        SuccessionCandidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  authorEmployee   Employee                 @relation("SuccessionNoteAuthorEmployee", fields: [authorEmployeeId], references: [id], onDelete: Restrict)

  @@index([orgId])
  @@index([candidateId, createdAt])
  @@index([authorEmployeeId])
}

model SuccessionCandidateSnapshot {
  id                           String              @id @default(cuid())
  orgId                        String
  candidateId                  String
  cycleId                      String?
  scorecardOverallRating       Int?
  scorecardPercent             Float?
  finalRatingSource            FinalRatingSource?
  calibrationPerformanceBucket CalibrationBucket?
  calibrationPotentialBucket   CalibrationBucket?
  snapshotDepartment           String?
  snapshotTitle                String?
  snapshotManagerEmployeeId    String?
  snapshotManagerName          String?
  createdAt                    DateTime            @default(now())
  updatedAt                    DateTime            @updatedAt
  org                          Org                 @relation(fields: [orgId], references: [id], onDelete: Restrict)
  candidate                    SuccessionCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  cycle                        ReviewCycle?        @relation(fields: [cycleId], references: [id], onDelete: SetNull)

  @@unique([candidateId, cycleId])
  @@index([orgId])
  @@index([candidateId])
  @@index([cycleId])
}

model ReviewPacket {
  id                        String                  @id @default(cuid())
  orgId                     String
  cycleId                   String
  subjectEmployeeId         String
  snapshotDepartment        String?
  snapshotTitle             String?
  snapshotManagerEmployeeId String?
  snapshotManagerName       String?
  totalScorecardPercent     Float?
  scorecardOverallRating    Int?
  finalRatingSource         FinalRatingSource?
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  org                       Org                     @relation(fields: [orgId], references: [id], onDelete: Restrict)
  cycle                     ReviewCycle             @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  subjectEmployee           Employee                @relation("ReviewPacketSubjectEmployee", fields: [subjectEmployeeId], references: [id], onDelete: Cascade)
  submissions               ReviewSubmission[]
  scorecardMetricResults    ScorecardMetricResult[]

  @@unique([cycleId, subjectEmployeeId])
  @@index([orgId])
  @@index([cycleId])
  @@index([subjectEmployeeId])
  @@index([cycleId, scorecardOverallRating])
  @@index([orgId, cycleId, snapshotDepartment, snapshotTitle])
  @@index([orgId, cycleId, finalRatingSource])
}

model ReviewSubmission {
  id                 String                 @id @default(cuid())
  orgId              String
  cycleId            String
  packetId           String
  subjectEmployeeId  String
  reviewerEmployeeId String
  relationship       ReviewRelationship
  status             ReviewSubmissionStatus @default(NOT_STARTED)
  dueAt              DateTime?
  submittedAt        DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  org                Org                    @relation(fields: [orgId], references: [id], onDelete: Restrict)
  cycle              ReviewCycle            @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  packet             ReviewPacket           @relation(fields: [packetId], references: [id], onDelete: Cascade)
  subjectEmployee    Employee               @relation("ReviewSubmissionSubjectEmployee", fields: [subjectEmployeeId], references: [id], onDelete: Cascade)
  reviewerEmployee   Employee               @relation("ReviewSubmissionReviewerEmployee", fields: [reviewerEmployeeId], references: [id], onDelete: Cascade)
  answers            ReviewAnswer[]

  @@unique([cycleId, subjectEmployeeId, reviewerEmployeeId, relationship])
  @@index([orgId])
  @@index([cycleId, status])
  @@index([cycleId, dueAt])
  @@index([packetId])
  @@index([subjectEmployeeId])
  @@index([reviewerEmployeeId])
}

model ReviewAnswer {
  id            String                 @id @default(cuid())
  orgId         String
  submissionId  String
  questionId    String
  responseText  String
  scaleRating   Int?
  notObserved   Boolean                @default(false)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  org           Org                    @relation(fields: [orgId], references: [id], onDelete: Restrict)
  submission    ReviewSubmission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question      ReviewTemplateQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)
  evidenceLinks AnswerEvidenceLink[]

  @@unique([submissionId, questionId])
  @@index([orgId])
  @@index([submissionId])
}

model ReviewCycleScorecardMetric {
  id            String             @id @default(cuid())
  orgId         String
  cycleId       String
  metricKey     ScorecardMetricKey
  weightPercent Float
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  org           Org                @relation(fields: [orgId], references: [id], onDelete: Restrict)
  cycle         ReviewCycle        @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@unique([cycleId, metricKey])
  @@index([orgId])
  @@index([cycleId])
}

model ScorecardMetricResult {
  id                 String             @id @default(cuid())
  orgId              String
  packetId           String
  metricKey          ScorecardMetricKey
  selfRating         Int?
  managerRating      Int?
  selfNotObserved    Boolean            @default(false)
  managerNotObserved Boolean            @default(false)
  blendedRating      Float?
  weightPercent      Float
  weightedPercent    Float?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  org                Org                @relation(fields: [orgId], references: [id], onDelete: Restrict)
  packet             ReviewPacket       @relation(fields: [packetId], references: [id], onDelete: Cascade)

  @@unique([packetId, metricKey])
  @@index([orgId])
  @@index([packetId])
}

model EvidenceItem {
  id                String               @id @default(cuid())
  orgId             String
  subjectEmployeeId String
  authorEmployeeId  String?
  type              EvidenceType
  visibility        EvidenceVisibility   @default(PRIVATE)
  content           String
  occurredAt        DateTime
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  org               Org                  @relation(fields: [orgId], references: [id], onDelete: Restrict)
  subjectEmployee   Employee             @relation("EvidenceSubjectEmployee", fields: [subjectEmployeeId], references: [id], onDelete: Cascade)
  authorEmployee    Employee?            @relation("EvidenceAuthorEmployee", fields: [authorEmployeeId], references: [id], onDelete: SetNull)
  answerLinks       AnswerEvidenceLink[]

  @@index([orgId])
  @@index([subjectEmployeeId, type])
}

model AnswerEvidenceLink {
  id             String       @id @default(cuid())
  orgId          String
  answerId       String
  evidenceItemId String
  createdAt      DateTime     @default(now())
  org            Org          @relation(fields: [orgId], references: [id], onDelete: Restrict)
  answer         ReviewAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  evidenceItem   EvidenceItem @relation(fields: [evidenceItemId], references: [id], onDelete: Cascade)

  @@unique([answerId, evidenceItemId])
  @@index([orgId])
  @@index([evidenceItemId])
}

model CalibrationSession {
  id                    String                          @id @default(cuid())
  orgId                 String
  cycleId               String
  name                  String
  roleGroup             String?
  description           String?
  isRestricted          Boolean                         @default(false)
  performanceAxisConfig Json?
  potentialAxisConfig   Json?
  isFinalized           Boolean                         @default(false)
  finalizedAt           DateTime?
  createdAt             DateTime                        @default(now())
  updatedAt             DateTime                        @updatedAt
  org                   Org                             @relation(fields: [orgId], references: [id], onDelete: Restrict)
  cycle                 ReviewCycle                     @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  placements            CalibrationPlacement[]
  participants          CalibrationSessionParticipant[]
  improvementPlans      ImprovementPlan[]
  snapshot              CalibrationSnapshot?

  @@index([orgId])
  @@index([cycleId])
  @@index([orgId, isFinalized])
  @@index([orgId, isRestricted])
}

model CalibrationSessionParticipant {
  id        String             @id @default(cuid())
  orgId     String
  sessionId String
  userId    String
  createdAt DateTime           @default(now())
  org       Org                @relation(fields: [orgId], references: [id], onDelete: Restrict)
  session   CalibrationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([orgId])
  @@index([sessionId])
  @@index([userId])
}

model CalibrationPlacement {
  id                String             @id @default(cuid())
  orgId             String
  sessionId         String
  employeeId        String
  performanceBucket CalibrationBucket  @default(MEDIUM)
  potentialBucket   CalibrationBucket  @default(MEDIUM)
  justificationNote String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  org               Org                @relation(fields: [orgId], references: [id], onDelete: Restrict)
  session           CalibrationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  employee          Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([sessionId, employeeId])
  @@index([orgId])
  @@index([sessionId])
  @@index([employeeId])
  @@index([sessionId, performanceBucket, potentialBucket])
}

model CalibrationSnapshot {
  id        String             @id @default(cuid())
  orgId     String
  sessionId String             @unique
  snapshot  Json
  createdAt DateTime           @default(now())
  org       Org                @relation(fields: [orgId], references: [id], onDelete: Restrict)
  session   CalibrationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model ImprovementPlan {
  id                String                   @id @default(cuid())
  orgId             String
  subjectEmployeeId String
  managerEmployeeId String
  hrOwnerEmployeeId String?
  createdByUserId   String
  triggerSource     ImprovementPlanTrigger   @default(REVIEW)
  reviewCycleId     String?
  calibrationSessionId String?
  title             String
  expectations      String
  startDate         DateTime
  endDate           DateTime
  status            ImprovementPlanStatus    @default(DRAFT)
  outcome           ImprovementPlanOutcome?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  org               Org                      @relation(fields: [orgId], references: [id], onDelete: Restrict)
  subjectEmployee   Employee                 @relation("ImprovementPlanSubjectEmployee", fields: [subjectEmployeeId], references: [id], onDelete: Restrict)
  managerEmployee   Employee                 @relation("ImprovementPlanManagerEmployee", fields: [managerEmployeeId], references: [id], onDelete: Restrict)
  hrOwnerEmployee   Employee?                @relation("ImprovementPlanHrOwnerEmployee", fields: [hrOwnerEmployeeId], references: [id], onDelete: SetNull)
  createdByUser     User                     @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  reviewCycle       ReviewCycle?             @relation(fields: [reviewCycleId], references: [id], onDelete: SetNull)
  calibrationSession CalibrationSession?     @relation(fields: [calibrationSessionId], references: [id], onDelete: SetNull)
  goals             ImprovementPlanGoal[]
  checkIns          ImprovementPlanCheckIn[]

  @@index([orgId])
  @@index([orgId, status])
  @@index([subjectEmployeeId])
  @@index([managerEmployeeId])
  @@index([hrOwnerEmployeeId])
  @@index([reviewCycleId])
  @@index([calibrationSessionId])
}

model ImprovementPlanGoal {
  id          String          @id @default(cuid())
  orgId       String
  planId      String
  title       String
  description String?
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  org         Org             @relation(fields: [orgId], references: [id], onDelete: Restrict)
  plan        ImprovementPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([planId, sortOrder])
}

model ImprovementPlanCheckIn {
  id           String                  @id @default(cuid())
  orgId        String
  planId       String
  authorUserId String
  content      String
  checkInType  ImprovementPlanCheckInType @default(NOTE)
  status       ImprovementPlanStatus?
  outcome      ImprovementPlanOutcome?
  checkInAt    DateTime                @default(now())
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  org          Org                     @relation(fields: [orgId], references: [id], onDelete: Restrict)
  plan         ImprovementPlan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  authorUser   User                    @relation(fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([orgId])
  @@index([planId, checkInAt])
  @@index([authorUserId])
}

model AuditEvent {
  id          String   @id @default(cuid())
  orgId       String
  actorUserId String
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime @default(now())
  org         Org      @relation(fields: [orgId], references: [id], onDelete: Restrict)
  actorUser   User     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([orgId, createdAt])
  @@index([entityType, entityId])
  @@index([actorUserId])
}
