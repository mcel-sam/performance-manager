{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "node -e \"const fs=require('node:fs'); ['.next/types','.next/dev/types','tsconfig.tsbuildinfo'].forEach((path)=>fs.rmSync(path,{recursive:true,force:true}))\" && next typegen && tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:e2e": "playwright test --grep-invert @ux",
    "test:e2e:ux": "playwright test --grep @ux",
    "test:e2e:ui": "playwright test --ui",
    "db:migrate:deploy": "node scripts/run-with-next-env.mjs prisma migrate deploy",
    "db:migrate:status": "node scripts/run-with-next-env.mjs prisma migrate status",
    "db:seed": "node scripts/run-with-next-env.mjs node prisma/seed.mjs",
    "db:sandbox:bootstrap": "node scripts/run-with-next-env.mjs node prisma/sandbox-bootstrap.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.17.1",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.100.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.7.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prisma": "^6.17.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
